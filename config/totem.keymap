#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30    // default: 10

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define mouse 5
#define mouse_fast 6
#define mouse_slow 7

&mmv {
    time-to-max-speed-ms = <10>;
    acceleration-exponent = <6>;
};

&msc {
    time-to-max-speed-ms = <10>;
    acceleration-exponent = <10>;
};

&lt { tapping-term-ms = <200>; };

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

&mmv_input_listener {
    mouse_fast {
        layers = <6>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};

&mmv_input_listener {
    mouse_slow {
        layers = <7>;
        input-processors = <&zip_xy_scaler 1 3>;
    };
};

&msc_input_listener {
    scroll_fast {
        layers = <6>;
        input-processors = <&zip_scroll_scaler 2 1>;
    };
};

&msc_input_listener {
    scroll_slow {
        layers = <7>;
        input-processors = <&zip_scroll_scaler 1 2>;
    };
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            //            hold-trigger-key-positions = < ... >; // List of keys on the right side of the keyboard
            //            hold-trigger-on-release;

            hold-trigger-key-positions = <5 15 26 16 6 7 17 28 27 8 18 29 9 19 30>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            //           hold-trigger-key-positions = < ... >; // List of keys on the left side of the keyboard
            //           hold-trigger-on-release;

            hold-trigger-key-positions = <0 0 1 4 10 11 12 13 14 21 22 23 24 25 2 3>;
            hold-trigger-on-release;
        };

        eq_b: eq_b {
            compatible = "zmk,behavior-tap-dance";
            label = "EQ_B";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&eq>;
        };

        minus_b: minus_b {
            compatible = "zmk,behavior-tap-dance";
            label = "MINUS_B";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&minus>;
        };

        plus_b: plus_b {
            compatible = "zmk,behavior-tap-dance";
            label = "PLUS_B";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&plus>;
        };

        div_b: div_b {
            compatible = "zmk,behavior-tap-dance";
            label = "DIV_B";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&div>;
        };

        mult_b: mult_b {
            compatible = "zmk,behavior-tap-dance";
            label = "MULT_B";
            #binding-cells = <0>;
            bindings = <&kp ASTRK>, <&mult>;
        };

        paren_b: paren_b {
            compatible = "zmk,behavior-tap-dance";
            label = "PAREN_B";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&paren>;
        };

        bracket_b: bracket_b {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACKET_B";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&brackets>;
        };

        curly_b: curly_b {
            compatible = "zmk,behavior-tap-dance";
            label = "CURLY_B";
            #binding-cells = <0>;
            bindings = <&kp LG(LEFT_BRACE)>, <&curly_braces>;
        };

        apos_quote: apos_quote {
            compatible = "zmk,behavior-mod-morph";
            label = "APOS_QUOTE";
            bindings = <&apos_td>, <&quote_td>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        apos_td: apos_td {
            compatible = "zmk,behavior-tap-dance";
            label = "APOS_TD";
            #binding-cells = <0>;
            bindings = <&apos_single>, <&apos_pair>;
        };

        quote_td: quote_td {
            compatible = "zmk,behavior-tap-dance";
            label = "QUOTE_TD";
            #binding-cells = <0>;
            bindings = <&quote_single>, <&quote_pair>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        left_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 0>;
        };

        enter {
            bindings = <&kp RET>;
            key-positions = <16 17 18>;
            timeout-ms = <100>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        r_word {
            bindings = <&kp LA(RIGHT)>;
            key-positions = <18 17>;
            layers = <2 0>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <18 19>;
            timeout-ms = <100>;
        };

        l_word {
            bindings = <&kp LA(LEFT)>;
            key-positions = <17 16>;
            layers = <0 2>;
            timeout-ms = <100>;
        };

        backspace2 {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 35>;
        };

        backspace3 {
            bindings = <&kp BACKSPACE>;
            key-positions = <34 13>;
        };

        close_tab {
            bindings = <&kp LG(W)>;
            key-positions = <9 35>;
            layers = <2 5 9>;
        };

        new_tab {
            bindings = <&kp LG(T)>;
            key-positions = <35 19>;
            layers = <2 5 9>;
        };

        reopen_tab {
            bindings = <&kp LG(LS(T))>;
            key-positions = <35 30>;
            layers = <2 5 9>;
        };

        del_word {
            bindings = <&kp LA(BACKSPACE)>;
            key-positions = <35 16 17>;
            layers = <0>;
        };

        del_word_fw {
            bindings = <&kp LA(DELETE)>;
            key-positions = <17 18 35>;
            layers = <0>;
        };

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <34 20>;
            layers = <8>;
        };

        bt_0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <34 21>;
            layers = <8>;
        };

        bt_1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <34 10>;
            layers = <8>;
        };

        bt_2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <34 0>;
            layers = <8>;
        };

        reset {
            bindings = <&sys_reset>;
            key-positions = <34 0 10 21>;
            layers = <8>;
        };

        language_switch {
            bindings = <&kp LC(SPACE)>;
            key-positions = <34 35>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <10 19>;
            timeout-ms = <100>;
        };

        mouse_layer {
            bindings = <&mo 5>;
            key-positions = <12 13>;
            slow-release;
            layers = <0>;
        };
    };

    macros {
        personal_email: personal_email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp U &kp R &kp Z &kp N4 &kp N2 &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
            label = "PERSONAL_EMAIL";
        };

        work_email: work_email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I &kp L &kp I &kp A &kp DOT &kp M &kp U &kp R &kp Z &kp I &kp N &kp O &kp V &kp AT &kp R &kp E &kp V &kp O &kp L &kp U &kp T &kp DOT &kp C &kp O &kp M>;
            label = "WORK_EMAIL";
        };

        thinking_face: thinking_face {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp T &kp H &kp I &kp N &kp K &kp I &kp N &kp G &kp UNDER &kp F &kp A &kp C &kp E &kp COLON>;
            label = "THINKING_FACE";
        };

        name: name {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(I) &kp L &kp I &kp A>;
            label = "NAME";
        };

        last_name: last_name {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(M) &kp U &kp R &kp Z &kp I &kp N &kp O &kp V>;
            label = "LAST_NAME";
        };

        eq: eq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EQUAL &kp SPACE>;
            label = "EQ";
        };

        mult: mult {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp STAR &kp SPACE>;
            label = "MULT";
        };

        div: div {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp FSLH &kp SPACE>;
            label = "DIV";
        };

        minus: minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp MINUS &kp SPACE>;
            label = "MINUS";
        };

        plus: plus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp PLUS &kp SPACE>;
            label = "PLUS";
        };

        paren: paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "PAREN";
        };

        brackets: brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
            label = "BRACKETS";
        };

        curly_braces: curly_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
            label = "CURLY_BRACES";
        };

        apos_single: apos_single {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT>;
            label = "APOS_SINGLE";
        };

        apos_pair: apos_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp SQT &kp LEFT>;
            label = "APOS_PAIR";
        };

        quote_single: quote_single {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT>;
            label = "QUOTE_SINGLE";
        };

        quote_pair: quote_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp DQT>,
                <&macro_release &kp LSHFT>,
                <&kp LEFT>;
            label = "QUOTE_PAIR";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
       &kp Q              &kp W         &kp E            &kp R            &kp T          &kp Y        &kp U            &kp I             &kp O         &kp P
       &hml LEFT_SHIFT A  &hml LCTRL S  &hml LEFT_ALT D  &hml LEFT_GUI F  &kp G          &kp H        &hmr LEFT_GUI J  &hmr RIGHT_ALT K  &hmr RCTRL L  &hmr RSHIFT SEMI
&none  &kp Z              &kp X         &kp C            &kp V            &kp B          &kp N        &kp M            &kp COMMA         &kp DOT       &apos_quote       &none
                                        &none            &mo 2            &lt 3 SPACE    &lt 4 SPACE  &mo 1            &mo 8
            >;
        };

        rus {
            bindings = <
        &trans  &kp LS(N7)  &trans  &trans  &kp GRAVE    &trans  &trans             &trans         &trans     &kp LEFT_BRACKET
        &trans  &trans      &trans  &trans  &trans       &trans  &trans             &trans         &trans     &kp APOS
&trans  &trans  &trans      &trans  &trans  &trans       &trans  &kp RIGHT_BRACKET  &kp LS(SLASH)  &kp SLASH  &trans            &trans
                            &trans  &trans  &trans       &trans  &trans             &trans
            >;
        };

        nav {
            bindings = <
       &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)      &kp LG(NUMBER_4)       &kp LG(N5)    &none     &kp PAGE_DOWN             &kp PAGE_UP                &none      &none
       &kp LEFT_SHIFT    &kp LC(UP_ARROW)  &kp LC(LEFT)          &kp LC(RIGHT)          &none         &kp LEFT  &kp DOWN                  &kp UP                     &kp RIGHT  &none
&none  &none             &none             &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &none         &none     &kp LG(LS(LEFT_BRACKET))  &kp LG(LS(RIGHT_BRACKET))  &none      &none  &trans
                                           &none                 &none                  &none         &none     &none                     &none
            >;
        };

        sym {
            bindings = <
       &kp EXCL   &kp QUESTION  &kp AT         &kp HASH  &kp DOLLAR    &none        &kp N7  &kp N8  &kp N9  &none
       &minus_b   &plus_b       &div_b         &mult_b   &kp CARET     &none        &kp N4  &kp N5  &kp N6  &eq_b
&none  &kp UNDER  &kp PERCENT   &kp BACKSLASH  &kp AMPS  &kp PIPE      &kp N0       &kp N1  &kp N2  &kp N3  &kp DOT  &none
                                &none          &none     &none         &lt 4 SPACE  &mo 9   &none
            >;
        };

        sym_add {
            bindings = <
       &none  &none  &none  &none  &none    &kp TILDE  &curly_b    &kp RIGHT_BRACE        &none  &none
       &none  &none  &none  &none  &none    &kp GRAVE  &paren_b    &kp RIGHT_PARENTHESIS  &none  &none
&none  &none  &none  &none  &none  &none    &none      &bracket_b  &kp RIGHT_BRACKET      &none  &none  &none
                     &none  &none  &none    &none      &none       &none
            >;
        };

        mouse {
            bindings = <
       &none           &none  &none   &none   &none           &msc SCRL_RIGHT  &msc SCRL_UP              &msc SCRL_DOWN             &msc SCRL_LEFT   &none
       &kp LEFT_SHIFT  &mo 6  &mo 7   &none   &none           &mmv MOVE_LEFT   &mmv MOVE_DOWN            &mmv MOVE_UP               &mmv MOVE_RIGHT  &none
&none  &none           &none  &none   &none   &none           &none            &kp LG(LS(LEFT_BRACKET))  &kp LG(LS(RIGHT_BRACKET))  &none            &none  &none
                              &trans  &trans  &kp LEFT_GUI    &mkp MB1         &mkp MB2                  &none
            >;
        };

        mouse_fast {
            bindings = <
  &none
            >;
        };

        mouse_slow {
            bindings = <
  &none
            >;
        };

        media {
            bindings = <
       &none                 &none              &none          &none                  &none    &none             &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none       &none
       &kp LG(LA(LC(LEFT)))  &kp LA(LG(LC(F)))  &kp LG(LC(F))  &kp LA(LG(LC(RIGHT)))  &none    &kp C_PLAY_PAUSE  &kp C_VOL_DN          &kp C_VOLUME_UP       &kp K_MUTE  &none
&none  &none                 &none              &none          &none                  &none    &none             &none                 &none                 &none       &none  &none
                                                &none          &none                  &none    &none             &none                 &none
            >;
        };

        macros {
            bindings = <
       &thinking_face  &none       &none            &none        &none    &none  &none  &none  &none  &none
       &name           &last_name  &personal_email  &work_email  &none    &none  &none  &none  &none  &none
&none  &none           &none       &none            &none        &none    &none  &none  &none  &none  &none  &none
                                   &none            &none        &none    &none  &none  &none
            >;
        };
    };
};
